{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//home/user/viart-app/**)",
      "Edit(//home/user/viart-app/app/**)",
      "Edit(//home/user/viart-app/public/**)",
      "Edit(//home/user/viart-app/*.ts)",
      "Edit(//home/user/viart-app/*.mjs)",
      "Edit(//home/user/viart-app/*.md)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "WebFetch(domain:21st.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:motion.dev)",
      "WebFetch(domain:tailwindcss.com)"
    ],
    "ask": [
      "Bash(npm run dev:*)",
      "Bash(npm start:*)",
      "Bash(git push --force:*)",
      "Bash(vercel:*)"
    ],
    "deny": [
      "Read(//home/user/viart-app/.env)",
      "Read(//home/user/viart-app/.env.*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["magic"]
}
